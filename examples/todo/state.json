{
  "app": "Tasks",
  "version": 12,
  "docs": "doc/README.md",
  "api": ["observe", "listen"],
  "tasks": {
    "path": "/tasks",
    "api": ["add", "clear_done", "undo", "page", "find"],
    "*": {
      "path": "/tasks/<task id>",
      "api": ["rename", "set_done", "delete"]
    },
    "1": { "title": "Buy milk", "done": true },
    "2": { "title": "Email the landlord about the radiator", "done": true },
    "3": { "title": "Book dentist appointment", "done": false }
  }
}
