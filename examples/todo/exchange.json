{
  "comment": "One round trip, starting from snapshot-main.json (seq 14). The agent renames a task; the app answers with a diff, not a new snapshot.",

  "request": {
    "seq": 14,
    "target": "task:3",
    "action": "rename",
    "args": { "title": "Book dentist for Tuesday" }
  },

  "response": {
    "ok": true,
    "seq": 15,
    "changes": [
      { "op": "set", "id": "task:3", "field": "title", "value": "Book dentist for Tuesday" },
      { "op": "set", "id": "toast", "field": "expires_in_ms", "value": 2300 }
    ]
  },

  "failure_example": {
    "request": { "seq": 15, "target": "add", "action": "press" },
    "response": {
      "ok": false,
      "seq": 15,
      "error": { "code": "invalid", "on": "new_title", "message": "You already have that task.", "conflicts_with": "task:1" }
    }
  },

  "stale_example": {
    "request": { "seq": 12, "target": "task:3", "action": "toggle" },
    "response": { "ok": false, "seq": 15, "error": { "code": "stale", "message": "State changed since seq 12; re-read or apply the diff first." } }
  }
}
