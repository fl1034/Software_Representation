[
  {
    "note": "The whole list fits in one answer; nothing is folded.",
    "call": {"action":"observe","path":"/"},
    "receive": [
      {"version":12,"node":{"app":"Tasks","tasks":{"api":["add","clear_done","undo","find"],"*":{"api":["rename","set_done","delete"]},"1":{"title":"Buy milk","done":true},"2":{"title":"Email the landlord about the radiator","done":true},"3":{"title":"Book dentist appointment","done":false}}}}
    ]
  },
  {
    "note": "After reading doc/tasks/_/set_done.md. Every action in this app is instant, so receipt and ping always arrive as one message.",
    "call": {"action":"set_done","path":"/tasks/3","done":true},
    "receive": [
      {"receipt":"s51","ping":{"version":13,"changed":["/tasks/3/done"]}}
    ]
  },
  {
    "call": {"action":"add","path":"/tasks","title":"Water plants"},
    "receive": [
      {"receipt":"s52","ping":{"version":14,"changed":["/tasks/4"]}}
    ]
  },
  {
    "note": "A duplicate title: the error comes as feedback, and nothing changes.",
    "call": {"action":"add","path":"/tasks","title":"buy MILK"},
    "receive": [
      {"receipt":"s53","feedback":{"error":"duplicate_title","message":"\"Buy milk\" already exists at /tasks/1."},"ping":{"version":14}}
    ]
  },
  {
    "call": {"action":"clear_done","path":"/tasks"},
    "receive": [
      {"receipt":"s54","ping":{"version":15,"removed":["/tasks/1","/tasks/2","/tasks/3"]}}
    ]
  },
  {
    "call": {"action":"undo","path":"/tasks"},
    "receive": [
      {"receipt":"s55","ping":{"version":16,"changed":["/tasks/1","/tasks/2","/tasks/3"]}}
    ]
  },
  {
    "call": {"action":"delete","path":"/tasks/99"},
    "receive": [
      {"receipt":"s56","feedback":{"error":"not_found","message":"No task at /tasks/99."},"ping":{"version":16}}
    ]
  }
