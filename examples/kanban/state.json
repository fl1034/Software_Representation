  "columns": {
    "path": "/columns",
    "api": ["add"],
    "*": {
      "path": "/columns/<column id>",
      "api": ["rename", "set_limit", "delete", "add_card", "archive_all"]
    },
    "c1": { "name": "Backlog",     "limit": null, "cards": ["k1", "k2", "k3"] },
    "c2": { "name": "In progress", "limit": 3,    "cards": ["k4", "k5", "k6"] },
    "c3": { "name": "Review",      "limit": 2,    "cards": ["k7"] },
    "c4": { "name": "Done",        "limit": null, "cards": ["k8"] }
  },

  "cards": {
    "path": "/cards",
    "api": ["page", "find"],
    "*": {
      "path": "/cards/<card id>",
      "api": ["rename", "set_description", "set_labels", "assign", "set_due", "move", "archive", "restore", "delete", "add_checklist_item", "comment"],
      "defaults": { "description": "", "labels": [], "assignee": null, "due": null, "overdue": false, "checklist": {}, "comments": {}, "archived": false },
      "derived": { "overdue": "due < today and the card is not in the last column" },
      "checklist": {
        "*": {
          "path": "/cards/<card id>/checklist/<item id>",
          "api": ["set_done", "remove"]
        }
      },
      "comments": {
        "path": "/cards/<card id>/comments",
        "api": ["page"]
      }
    },
